# ── Milvus ──────────────────────────────────────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=                          # Milvus 인증 토큰 (없으면 빈 값)
MILVUS_COLLECTION=documents            # 기본 컬렉션 이름

# ── Cloud Platform Embedding API ─────────────────────────────────────────────
EMBEDDING_API_ENDPOINT=https://api.company.internal/v1/embeddings
RERANK_API_ENDPOINT=                   # 리랭커 rerank API 경로 (없으면 EMBEDDING_API_ENDPOINT의 마지막 경로를 rerank로 바꿔 자동 유도)
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small # Cloud Platform에서 제공하는 모델명 (차원은 API 호출로 자동 감지)
EMBEDDING_BATCH_SIZE=64                # API 호출당 최대 텍스트 수
EMBEDDING_TIMEOUT=60                   # API 타임아웃 (초)
